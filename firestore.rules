rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/routeGraphs/openstreetmap {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'nodes', 'edges', 'nextId', 'startId', 'endId', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'nodes', 'edges', 'nextId', 'startId', 'endId', 'updatedAt'
        ])
        && request.resource.data.nodes is list
        && request.resource.data.nodes.size() <= 5000
        && request.resource.data.edges is list
        && request.resource.data.edges.size() <= 15000
        && request.resource.data.nextId is int
        && (request.resource.data.startId == null || request.resource.data.startId is string)
        && (request.resource.data.endId == null || request.resource.data.endId is string)
        && request.resource.data.updatedAt == request.time;
    }

    match /cityMaps/manila {
      function signedIn() {
        return request.auth != null;
      }

      function validStreetMap() {
        return
          (
            (
              request.resource.data.keys().hasOnly(['nodes', 'edges', 'updatedAt'])
              && request.resource.data.keys().hasAll(['nodes', 'edges', 'updatedAt'])
              && request.resource.data.nodes is list
              && request.resource.data.nodes.size() <= 2000
              && request.resource.data.edges is list
              && request.resource.data.edges.size() <= 4000
            ) || (
              request.resource.data.keys().hasOnly(['nodes', 'connectors', 'updatedAt'])
              && request.resource.data.keys().hasAll(['nodes', 'connectors', 'updatedAt'])
              && request.resource.data.nodes is list
              && request.resource.data.nodes.size() <= 2000
              && request.resource.data.connectors is list
              && request.resource.data.connectors.size() <= 4000
            )
          ) && request.resource.data.updatedAt is number
        || (
          request.resource.data.keys().hasOnly(['format', 'generation', 'nodeChunks', 'edgeChunks', 'updatedAt'])
          && request.resource.data.keys().hasAll(['format', 'generation', 'nodeChunks', 'edgeChunks', 'updatedAt'])
          && request.resource.data.format == 'chunked-v1'
          && request.resource.data.generation is string
          && request.resource.data.nodeChunks is int
          && request.resource.data.nodeChunks >= 0
          && request.resource.data.nodeChunks <= 200
          && request.resource.data.edgeChunks is int
          && request.resource.data.edgeChunks >= 0
          && request.resource.data.edgeChunks <= 200
          && request.resource.data.updatedAt is number
        );
      }

      // The city street graph is public map data; only signed-in users may publish edits.
      allow read: if true;
      allow create, update: if signedIn() && validStreetMap();

      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['kind', 'generation', 'index', 'items'])
          && request.resource.data.keys().hasAll(['kind', 'generation', 'index', 'items'])
          && request.resource.data.kind in ['nodes', 'edges']
          && request.resource.data.generation is string
          && request.resource.data.index is int
          && request.resource.data.index >= 0
          && request.resource.data.index < 200
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 2000;
        allow delete: if signedIn();
      }
    }
  }
}
